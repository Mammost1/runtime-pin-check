{
  "name": "runtime-pin-check",
  "version": "0.1.0",
  "description": "Find Node, Python and Go version pins that disagree across a repo's files, with file and line.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "runtime-pin-check": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "node-version",
    "nvmrc",
    "engines",
    "python-version",
    "go-version",
    "ci",
    "monorepo"
  ],
  "dependencies": {
    "semver": "7.7.2",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.7.0",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mammost1/runtime-pin-check.git"
  },
  "homepage": "https://github.com/Mammost1/runtime-pin-check#readme",
  "bugs": {
    "url": "https://github.com/Mammost1/runtime-pin-check/issues"
  }
}
